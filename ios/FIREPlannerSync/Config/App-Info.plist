<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSFinancialDataDescription</key>
	<string>FIRE Planner Sync sends your Apple Card, Apple Cash and Savings balances and transactions, encrypted, to FIRE Planner on your own Mac so it can measure your spending and plan your debt payoff.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.showupshowout.fireplanner.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.showupshowout.fireplanner</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>FIRE Planner Sync</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>One</string>
		</dict>
	</dict>
</dict>
</plist>
