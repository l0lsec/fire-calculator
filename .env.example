# Copy to .env (git-ignored) and fill in. Never commit real values.

# Plaid: use the SANDBOX client id and secret from dashboard.plaid.com (Developers > Keys).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Public URL Plaid calls for webhooks (a tunnel in local dev; the Worker URL in production).
PLAID_WEBHOOK_URL=

# Token encryption keyring: "<version>:<base64 32 bytes>", comma-separated.
# Generate one with: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEYS=

# Database (local Supabase stack from `pnpm db:up`).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55322/postgres

# Supabase Auth (local stack values are printed by `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Shared secret for the cron and queue handlers calling internal routes.
CRON_SECRET=
