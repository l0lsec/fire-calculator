{
  "name": "fire-calculator",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "guards": "node scripts/guards/run-all.mjs",
    "guards:selftest": "node scripts/guards/run-all.mjs --selftest",
    "dev": "pnpm --filter @fire/web dev",
    "build": "pnpm --filter @fire/web build",
    "gates": "node ~/.claude/skills/unlazy/scripts/gate-check.mjs --status",
    "plaid:record": "node --env-file-if-exists=.env --import tsx scripts/plaid/record-sandbox.ts",
    "db:up": "supabase start -x vector,logflare,imgproxy,supavisor,studio,postgres-meta",
    "db:down": "supabase stop",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db-migrate.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "sync": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/sync-all.ts",
    "backup": "node scripts/backup.mjs",
    "verify:financekit": "node --import tsx scripts/verify/financekit-swift-format.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "24.13.3",
    "fast-check": "4.9.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "@playwright/test": "1.62.1",
    "axe-core": "4.13.0",
    "@fire/db": "workspace:*",
    "@fire/engine": "workspace:*",
    "@fire/plaid": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "postgres": "3.4.9"
  }
}
